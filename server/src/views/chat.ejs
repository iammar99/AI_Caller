<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurant AI Chat</title>

  <style>
    :root {
      --brand: #146c43;
      --brand-dark: #0f5434;
      --brand-tint: #e7f2ec;
      --bg: #e8edea;
      --surface: #ffffff;
      --line: #dde4e0;
      --text: #1c2622;
      --muted: #68756e;
      --bot: #f2f5f3;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    * { box-sizing: border-box; }

    html, body { height: 100%; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .chat {
      width: 100%;
      max-width: 720px;
      height: min(92vh, 900px);
      background: var(--surface);
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(20, 50, 35, .12);
    }

    /* ---------- header ---------- */
    header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
    }

    .logo {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--brand);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 18px;
      flex-shrink: 0;
    }

    .title { flex: 1; min-width: 0; }
    .title h1 { margin: 0; font-size: 16px; font-weight: 650; }
    .title p { margin: 2px 0 0; font-size: 13px; color: var(--muted); }

    button { font: inherit; cursor: pointer; }

    #newChat {
      padding: 8px 14px;
      border-radius: 10px;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--text);
      font-size: 14px;
    }
    #newChat:hover { background: var(--bot); }

    /* ---------- messages ---------- */
    #messages {
      flex: 1;
      overflow-y: auto;
      padding: 20px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      scroll-behavior: smooth;
    }

    .message {
      max-width: 85%;
      padding: 11px 14px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 15px;
      overflow-wrap: anywhere;
    }

    .message.user {
      align-self: flex-end;
      background: var(--brand);
      color: #fff;
      border-bottom-right-radius: 5px;
      white-space: pre-wrap;
    }

    .message.bot {
      align-self: flex-start;
      background: var(--bot);
      border-bottom-left-radius: 5px;
    }

    .message.error {
      background: #fdeceb;
      color: #8a1f17;
    }

    /* rendered markdown inside bot bubbles */
    .message.bot > :first-child { margin-top: 0; }
    .message.bot > :last-child { margin-bottom: 0; }
    .message.bot p { margin: 0 0 8px; }
    .message.bot p.h { font-weight: 650; margin-top: 10px; }
    .message.bot ul, .message.bot ol { margin: 4px 0 8px; padding-left: 22px; }
    .message.bot li { margin: 2px 0; }
    .message.bot code {
      background: rgba(0, 0, 0, .07);
      padding: 1px 5px;
      border-radius: 5px;
      font-size: 13px;
    }

    .tablewrap { overflow-x: auto; margin: 6px 0 10px; }

    table {
      border-collapse: collapse;
      width: 100%;
      font-size: 14px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
    }
    th, td { padding: 8px 12px; text-align: left; white-space: nowrap; }
    th {
      background: var(--brand-tint);
      color: var(--brand-dark);
      font-weight: 650;
      border-bottom: 1px solid var(--line);
    }
    td { border-top: 1px solid var(--line); }
    tbody tr:first-child td { border-top: none; }

    /* typing indicator */
    .typing { display: flex; gap: 5px; padding: 15px 16px; }
    .typing span {
      width: 7px; height: 7px; border-radius: 50%;
      background: #9aa7a0;
      animation: blink 1.2s infinite ease-in-out;
    }
    .typing span:nth-child(2) { animation-delay: .15s; }
    .typing span:nth-child(3) { animation-delay: .3s; }
    @keyframes blink { 0%, 80%, 100% { opacity: .3; } 40% { opacity: 1; } }

    /* ---------- suggestions ---------- */
    .suggestions {
      display: flex;
      gap: 8px;
      padding: 4px 18px 12px;
      overflow-x: auto;
    }
    .suggestions button {
      white-space: nowrap;
      background: var(--surface);
      color: var(--brand-dark);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 14px;
    }
    .suggestions button:hover { background: var(--brand-tint); border-color: var(--brand); }

    /* ---------- composer ---------- */
    form {
      padding: 12px 18px 10px;
      border-top: 1px solid var(--line);
    }

    .composer {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      background: var(--bot);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 8px 8px 8px 16px;
    }
    .composer:focus-within { border-color: var(--brand); background: var(--surface); }

    textarea {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      background: transparent;
      resize: none;
      font: inherit;
      font-size: 15px;
      line-height: 1.5;
      max-height: 140px;
      padding: 7px 0;
      color: var(--text);
    }

    #send {
      width: 42px;
      height: 42px;
      border: none;
      border-radius: 12px;
      background: var(--brand);
      color: #fff;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    #send:hover:not(:disabled) { background: var(--brand-dark); }
    #send:disabled { opacity: .45; cursor: default; }
    #send svg { width: 20px; height: 20px; }

    .hint { margin: 7px 2px 0; font-size: 12px; color: var(--muted); }

    button:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    @media (max-width: 560px) {
      .chat { height: 100dvh; max-width: none; border-radius: 0; }
      .message { max-width: 92%; }
      .hint { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      #messages { scroll-behavior: auto; }
      .typing span { animation: none; opacity: .6; }
    }
  </style>
</head>

<body>
  <main class="chat">
    <header>
      <div class="logo" aria-hidden="true">R</div>
      <div class="title">
        <h1>Restaurant AI</h1>
        <p>Ask about the menu, place an order, or check an order</p>
      </div>
      <button id="newChat" type="button">New chat</button>
    </header>

    <section id="messages" aria-live="polite"></section>

    <div class="suggestions">
      <button type="button" data-msg="Bhai menu dikhao">View menu</button>
      <button type="button" data-msg="Bhai 2 Zinger burgers laga do">Order 2 Zinger burgers</button>
      <button type="button" data-msg="What is the status of my order?">Check order status</button>
    </div>

    <form id="chatForm">
      <div class="composer">
        <textarea id="message" rows="1" placeholder="Type your message" aria-label="Message"></textarea>
        <button id="send" type="submit" aria-label="Send message">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
        </button>
      </div>
      <p class="hint">Enter sends your message. Shift + Enter adds a new line.</p>
    </form>
  </main>

  <script>
    const messages = document.getElementById("messages");
    const form = document.getElementById("chatForm");
    const input = document.getElementById("message");
    const send = document.getElementById("send");

    const WELCOME = "Assalam-o-Alaikum! Welcome to our restaurant. What would you like to order?";

    let history = [];
    let busy = false;

    /* ---------- tiny, safe markdown renderer (escapes HTML first) ---------- */
    // --- markdown start
    const esc = (s) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    function inline(s) {
      s = esc(s);
      s = s.replace(/`([^`]+)`/g, "<code>$1</code>");
      s = s.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
      s = s.replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>");
      return s;
    }

    const TABLE_SEP = /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$/;
    const UL = /^\s*[-*•]\s+/;
    const OL = /^\s*\d+[.)]\s+/;
    const HEADING = /^#{1,4}\s+/;

    function renderMarkdown(md) {
      const lines = md.replace(/\r/g, "").split("\n");
      const cells = (l) => l.trim().replace(/^\||\|$/g, "").split("|").map((c) => c.trim());
      let html = "";
      let i = 0;

      while (i < lines.length) {
        const line = lines[i];

        if (!line.trim()) { i++; continue; }

        // table
        if (line.includes("|") && i + 1 < lines.length && TABLE_SEP.test(lines[i + 1])) {
          const head = cells(line);
          i += 2;
          const rows = [];
          while (i < lines.length && lines[i].trim() && lines[i].includes("|")) {
            rows.push(cells(lines[i]));
            i++;
          }
          html += '<div class="tablewrap"><table><thead><tr>' +
            head.map((h) => `<th>${inline(h)}</th>`).join("") +
            "</tr></thead><tbody>" +
            rows.map((r) => "<tr>" + r.map((c) => `<td>${inline(c)}</td>`).join("") + "</tr>").join("") +
            "</tbody></table></div>";
          continue;
        }

        // heading
        if (HEADING.test(line)) {
          html += `<p class="h">${inline(line.replace(HEADING, ""))}</p>`;
          i++;
          continue;
        }

        // lists
        if (UL.test(line) || OL.test(line)) {
          const ordered = OL.test(line);
          const re = ordered ? OL : UL;
          const items = [];
          while (i < lines.length && re.test(lines[i])) {
            items.push(lines[i].replace(re, ""));
            i++;
          }
          const tag = ordered ? "ol" : "ul";
          html += `<${tag}>` + items.map((t) => `<li>${inline(t)}</li>`).join("") + `</${tag}>`;
          continue;
        }

        // paragraph (always consumes at least one line)
        const para = [line];
        i++;
        while (
          i < lines.length && lines[i].trim() &&
          !HEADING.test(lines[i]) && !UL.test(lines[i]) && !OL.test(lines[i]) &&
          !(lines[i].includes("|") && i + 1 < lines.length && TABLE_SEP.test(lines[i + 1]))
        ) {
          para.push(lines[i]);
          i++;
        }
        html += `<p>${para.map(inline).join("<br>")}</p>`;
      }
      return html;
    }
    // --- markdown end

    /* ---------- UI helpers ---------- */
    function scrollDown() {
      messages.scrollTop = messages.scrollHeight;
    }

    function addMessage(text, role) {
      const div = document.createElement("div");
      div.className = `message ${role}`;
      if (role === "bot") div.innerHTML = renderMarkdown(text);
      else div.textContent = text; // user text stays plain; CSS keeps its line breaks
      messages.appendChild(div);
      scrollDown();
      return div;
    }

    function addError(text) {
      const div = addMessage(text, "bot");
      div.classList.add("error");
    }

    function addTyping() {
      const div = document.createElement("div");
      div.className = "message bot typing";
      div.setAttribute("aria-label", "Assistant is typing");
      div.innerHTML = "<span></span><span></span><span></span>";
      messages.appendChild(div);
      scrollDown();
      return div;
    }

    function resizeInput() {
      input.style.height = "auto";
      input.style.height = Math.min(input.scrollHeight, 140) + "px";
    }

    function setBusy(state) {
      busy = state;
      send.disabled = state;
      input.disabled = state;
      if (!state) input.focus();
    }

    /* ---------- chat ---------- */
    async function sendMessage(raw) {
      const text = raw.trim();
      if (busy || !text) return;

      setBusy(true);
      addMessage(text, "user");
      input.value = "";
      resizeInput();

      const typing = addTyping();

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: text, history })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Request failed");

        typing.remove();
        const reply = data.reply || "No reply received.";
        addMessage(reply, "bot");

        history.push(
          { role: "user", content: text },
          { role: "assistant", content: reply }
        );
      } catch (err) {
        typing.remove();
        addError("Something went wrong: " + err.message + ". Please try again.");
      } finally {
        setBusy(false);
      }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      sendMessage(input.value);
    });

    // Enter = send, Shift + Enter = new line
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    input.addEventListener("input", resizeInput);

    document.querySelectorAll("[data-msg]").forEach((button) => {
      button.addEventListener("click", () => sendMessage(button.dataset.msg));
    });

    function startChat() {
      history = [];
      messages.replaceChildren();
      addMessage(WELCOME, "bot");
      input.focus();
    }

    document.getElementById("newChat").addEventListener("click", startChat);

    startChat();
  </script>
</body>
</html>
